{
  "name": "frekans",
  "version": "1.0.0",
  "private": true,
  "description": "Wavelength klonu - kooperatif, ozel spektrumlu web oyunu",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-force-exit --test-timeout=180000 test/*.test.mjs",
    "test:unit": "node --test test/scoring.test.mjs test/logic.test.mjs test/teams.test.mjs test/deck.test.mjs",
