{
  // Frekans — Realtime Database güvenlik kuralları.
  //
  // Oyunun gizli verileri hedefin konumu ve tahmin ibreleridir; ikisi de
  // kural düzeyinde korunur, arayüzde gizlemekle yetinilmez.
  //
  // ÖNEMLİ: RTDB'de üst düğüme verilen .read alt düğümlerde İPTAL EDİLEMEZ.
  // Bu yüzden "rooms/$code" seviyesinde .read TANIMLANMAZ; izin her alt
  // düğüme tek tek verilir, gizli düğümler kendi kurallarıyla ayrı durur.
  //
  // Hazır spektrum seti artık veritabanında değil, uygulamayla geliyor
  // (public/js/builtin.js). Kimse silemez.

  "rules": {
    ".read": false,
    ".write": false,

    // ── Kişiye özel: profil ve kendi spektrum setleri ──────────────────
    // Yalnızca sahibi okur ve yazar. Misafir (anonim) hesap set kaydedemez.
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider != 'anonymous'",

        "profile": {
          "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 14" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other":    { ".validate": false }
        },

        "packs": {
          "$packId": {
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'cards'])",
            "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "cards": {
              "$i": {
                "l":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 28" },
                "r":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 28" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    // ── Süresi dolmuş odaları bulmak için dizin ────────────────────────
    // Değer = odanın bitiş zamanı. Süpürücü buradan sıralı okur.
    "roomIndex": {
      ".read": "auth != null",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null",
        ".validate": "!newData.exists() || newData.isNumber()"
      }
    },

    "rooms": {
      "$code": {

        // Odayı tümüyle silme: kuran kişi her zaman, ömrü dolduysa herkes.
        // (Veri yazma bu seviyede kapalı; alt düğümlere iniyor.)
        ".write": "auth != null && !newData.exists() && (data.child('meta/hostUid').val() === auth.uid || now > data.child('meta/expiresAt').val())",

        "meta": {
          ".read": "auth != null",
          // Oda kurmak/devralmak hesap ister: misafir oda kuramaz.
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
          "createdAt": { ".validate": "newData.isNumber()" },
          "expiresAt": { ".validate": "newData.isNumber()" },
          "hostUid":   { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other":    { ".validate": false }
        },

        // Odanın destesi. Yalnızca kurucu, yalnızca lobide değiştirebilir.
        "deck": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid && root.child('rooms/' + $code + '/state/phase').val() === 'lobby'",
          "source": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "name":   { ".validate": "newData.isString() && newData.val().length <= 32" },
          "cards": {
            "$i": {
              "l":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 28" },
              "r":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 28" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },

        "players": {
          ".read": "auth != null",
          // Toplu silme yalnızca bayat oda devralınırken gerekir. Bu kural
          // sadece "players tamamen siliniyor" durumunda geçer; normal
          // yazımlarda newData var olduğu için aşağıdaki $uid kuralına düşer.
          ".write": "auth != null && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 14" },
            "online":   { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        },

        // Faz makinesi ve takım dağılımı. Tüm geçişler transaction ile.
        "state": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        // Tur sonuçları. İçerik deterministik olduğu için kim yazarsa aynı.
        "history": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        "usedSpectrumIds": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        // Kim kilitledi. Herkese açık (arayüzde "2/3 kilitledi" yazar),
        // ama kimse başkasının kilidini basamaz.
        "locks": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists()",
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            }
          }
        },

        // Tahmin ibreleri. Hedef kadar gizli: tahminciler birbirini GÖREMEZ,
        // psişik canlı görür, faz 'reveal' olunca herkese açılır.
        "guesses": {
          ".write": "auth != null && !newData.exists()",
          "$round": {
            ".read": "auth != null && (root.child('rooms/' + $code + '/state/psychicUid').val() === auth.uid || root.child('rooms/' + $code + '/state/phase').val() === 'reveal')",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              // Yalnızca tahmin fazında yazılabilir: açılıştan sonra liste
              // donduğu için her cihaz aynı puanları hesaplar.
              ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/state/phase').val() === 'guess'",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            }
          }
        },

        "secret": {
          // Toplu silme yalnızca bayat oda devralınırken.
          ".write": "auth != null && !newData.exists()",
          "target": {
            ".read": "auth != null && (root.child('rooms/' + $code + '/state/psychicUid').val() === auth.uid || root.child('rooms/' + $code + '/state/phase').val() === 'reveal')",
            ".write": "auth != null && root.child('rooms/' + $code + '/state/psychicUid').val() === auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          }
        }
      }
    }
  }
}
